{
  "ConnectionStrings": {
    "PostgreConnectionString": "Host=localhost;Port=5432;Database=authentication_authorization_demo;Username=myuser;Password=mypassword",
    "MongoDBConnectionString": "mongodb://localhost:27017/raksha_db",
    "RedisConnectionString": "localhost:6379"
  },
  "JwtSettings": {
    "Secret": "m$N8v#2P*L9zXq!5&Wb6@G1r^Y4tZ7e]",
    "Issuer": "Raksha.Api",
    "Audience": "Raksha.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "FileSettings": {
    "ProfilePictureStoragePath": "uploads/profile-pictures",
    "MaxFileSizeBytes": 2097152,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
